# Copy this file to .env. Never commit .env or real credential values.

SYNTAX_TREE_REFURBISHED_ENV=development
SYNTAX_TREE_REFURBISHED_LOG_LEVEL=INFO
SYNTAX_TREE_REFURBISHED_DB_PATH=.syntax-tree-refurbished/backend.sqlite

# Optional live-LLM provider: leave blank for deterministic/offline operation.
# Supported values: blackbox, openrouter.
SYNTAX_TREE_LLM_PROVIDER=
OPENROUTER_MODEL=blackboxai/anthropic/claude-sonnet-4.6
BLACKBOX_MODEL=blackboxai/anthropic/claude-sonnet-4.6

# Optional credentials. Supply only the key for the selected provider.
BLACKBOX_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=

# TLS verification must remain enabled outside controlled local diagnostics.
SYNTAX_TREE_LLM_SSL_VERIFY=1
SYNTAX_TREE_LLM_TIMEOUT_SECONDS=120

# Optional browser-facing WebSocket origin for deployments that do not proxy /api.
# Leave blank for same-origin ws/wss with the Vite/deployment proxy.
VITE_WS_BASE_URL=
