      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:warning|unsupported|success)$/]",
        "message": "<Callout> tone must be one of 'warning' | 'unsupported' | 'success'."
