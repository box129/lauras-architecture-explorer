{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/epistemic/**",
              "components/evidence/**",
              "components/feedback/**",
              "components/forms/**",
              "components/map/**",
              "components/navigation/**",
              "ui_kits/lauras-graph/**",
              "ui_kits/lauras-redesign/**",
              "ui_kits/syntax-tree/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Inter, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AIInterpretationCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|name|description|groundTruth|onGenerate|onRegenerate|generatedAt|key|ref|className|style|children)$/]",
        "message": "<AIInterpretationCard> doesn't accept that prop. Declared props: state, name, description, groundTruth, onGenerate, onRegenerate, generatedAt."
      },
      {
        "selector": "JSXOpeningElement[name.name='AIInterpretationCard'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:available|generating|generated|unavailable)$/]",
        "message": "<AIInterpretationCard> state must be one of 'available' | 'generating' | 'generated' | 'unavailable'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArchitectureTreeNode'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|kind|moduleCount|aiName|children|key|ref|className|style|children)$/]",
        "message": "<ArchitectureTreeNode> doesn't accept that prop. Declared props: id, label, kind, moduleCount, aiName, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArchitectureTreeNode'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:region|cluster|residual|module|symbol)$/]",
        "message": "<ArchitectureTreeNode> kind must be one of 'region' | 'cluster' | 'residual' | 'module' | 'symbol'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BreadcrumbItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|title|key|ref|className|style|children)$/]",
        "message": "<BreadcrumbItem> doesn't accept that prop. Declared props: id, label, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconAfter|disabled|children|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconAfter, disabled, children, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|quiet|secondary|pill)$/]",
        "message": "<Button> variant must be one of 'primary' | 'quiet' | 'secondary' | 'pill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|children|key|ref|className|style|children)$/]",
        "message": "<Callout> doesn't accept that prop. Declared props: tone, icon, children."
