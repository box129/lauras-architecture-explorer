        "selector": "JSXOpeningElement[name.name='LensNode'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|kind|description|status|accent|icon|evidenceCount|childrenCount|members|warning|group|collapsedContainer|selected|canDrilldown|onClick|key|ref|className|style|children)$/]",
